{"step": 6, "name": "shops_clean", "module": "src.shops_clean", "description": "Очистка панели магазин - месяц, разбор населенных пунктов", "inputs": ["Data/Shops/train_2.csv", "Data/Interim/regions.csv"], "outputs": ["Data/Interim/stores.parquet", "Data/Interim/store_months.parquet"]}
