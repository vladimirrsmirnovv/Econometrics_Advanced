{"step": 10, "name": "panel", "module": "src.panel", "description": "Итоговая панель населенный пункт - месяц", "inputs": ["Data/Interim/settlement_geography.parquet", "Data/Interim/settlement_population.parquet", "Data/Interim/settlement_months.parquet", "Data/Inflation/consumer_price_index_by_region.csv", "Data/Wages/nominal_wage_by_region.csv", "Data/Unemployment/unemployment_rate_monthly_by_region.csv", "Data/Unemployment/unemployment_rate_annual_by_region.csv"], "outputs": ["Data/settlement_panel.parquet"]}
