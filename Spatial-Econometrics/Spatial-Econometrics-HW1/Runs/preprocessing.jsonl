{"step": 1, "name": "rosstat_inflation", "module": "src.rosstat_inflation", "description": "Индексы потребительских цен по субъектам: xlsx -> csv", "inputs": ["Data/Inflation/ipc_RF_fo_sub_08-2026.xlsx"], "outputs": ["Data/Inflation/consumer_price_index_by_region.csv"]}
